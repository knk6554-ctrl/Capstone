# 서버에서만 사용하는 카카오 REST API 키
KAKAO_REST_API_KEY=여기에_REST_API_키

# 웹 지도 SDK에 사용하는 JavaScript 키
# 브라우저에 공개되는 키이므로 카카오 개발자 콘솔에서 허용 도메인을 제한하세요.
KAKAO_JAVASCRIPT_KEY=여기에_JavaScript_키

# 길 안내 진동 거리 기준(미터)
WAYBAND_PREPARE_DISTANCE_METERS=25
WAYBAND_TURN_NOW_DISTANCE_METERS=8
WAYBAND_OFF_ROUTE_DISTANCE_METERS=35

# ToF 경고 기준(밀리미터)
WAYBAND_TOF_WARNING_MM=1200
WAYBAND_TOF_CRITICAL_MM=600
WAYBAND_TOF_CLEAR_MM=1500
